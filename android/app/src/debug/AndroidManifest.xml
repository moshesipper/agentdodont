<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the laptop inject agent-style calls over adb to test the policy
     before Claude is connected. Protected by DUMP, which the adb shell holds and ordinary apps
     cannot obtain. Not present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugAgentReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.aos.launcher.DEBUG_AGENT_CALL" />
                <action android:name="dev.aos.launcher.DEBUG_AGENT_TASK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
